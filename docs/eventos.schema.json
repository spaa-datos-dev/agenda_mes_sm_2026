{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agenda del Mes de la Salud Mental 2026",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "status", "source", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "updatedAt": {"type": "string", "format": "date"},
    "status": {"enum": ["borrador", "publicado"]},
    "source": {"type": "string"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "time", "title", "description", "locality", "venue", "category", "modality", "organizer", "sourceRow"],
        "properties": {
          "id": {"type": "string", "pattern": "^sm2026-[0-9]{3,}$"},
          "date": {"type": "string", "format": "date"},
          "time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "locality": {"type": ["string", "null"]},
          "venue": {"type": ["string", "null"]},
          "category": {"enum": ["Taller y formación", "Recreación y deporte", "Espacio público"]},
          "modality": {"enum": ["Presencial", "Virtual"]},
          "organizer": {"type": ["string", "null"]},
          "sourceRow": {"type": ["integer", "null"], "minimum": 2}
        }
      }
    }
  }
}
